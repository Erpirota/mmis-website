---
import { featuresList } from '../config/site';
import Icon from './Icon.astro';
---

<section class="section features-section" id="features">
  <div class="container">
    <div class="section-header reveal">
      <span class="section-tag">
        <Icon name="scan" size={14} />
        <span>Capabilities</span>
      </span>
      <h2 class="section-title">Everything You Need to Debug a Modpack</h2>
      <p class="section-desc">
        Comprehensive inspection across Fabric, Quilt, Forge, and NeoForge modpacks. Includes both the desktop GUI and headless <code>mmis-cli.exe</code>.
      </p>
    </div>

    <div class="features-grid">
      {featuresList.map((item) => (
        <article class="feature-card card reveal" data-glow-card>
          <div class="feature-header">
            <div class="feature-icon-wrapper">
              <Icon name={item.icon} size={22} class="feature-icon" />
            </div>
            {item.tag && <span class="badge feature-tag">{item.tag}</span>}
          </div>
          <h3 class="feature-title">{item.title}</h3>
          <p class="feature-desc">{item.description}</p>
        </article>
      ))}
    </div>
  </div>
</section>
