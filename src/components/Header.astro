---
import { siteConfig } from '../config/site';
import Icon from './Icon.astro';
---

<header class="header" id="header">
  <div class="header-container">
    <a href="#hero" class="logo-link" aria-label={`${siteConfig.appName} Home`}>
      <Icon name="package" size={26} class="logo-icon" />
      <span class="logo-text">{siteConfig.appName}</span>
    </a>

    <nav class="nav-desktop" aria-label="Main Navigation">
      <a href="#features" class="nav-link">Features</a>
      <a href="#screenshots" class="nav-link">Screenshots</a>
      <a href="#how-it-works" class="nav-link">How it works</a>
      <a href="#download" class="nav-link">Download</a>
      <a href="#requirements" class="nav-link">Requirements</a>
      <a href="#changelog" class="nav-link">Changelog</a>
      <a href="#faq" class="nav-link">FAQ</a>
      <a href={siteConfig.downloadUrl} class="btn btn-primary nav-cta">
        <Icon name="download" size={16} />
        <span>Download</span>
      </a>
    </nav>

    <button
      id="mobile-menu-toggle"
      class="mobile-menu-btn"
      type="button"
      aria-label="Toggle navigation menu"
      aria-expanded="false"
      aria-controls="mobile-nav"
    >
      <span class="menu-icon-hamburger">
        <Icon name="menu" size={24} />
      </span>
      <span class="menu-icon-close" hidden>
        <Icon name="close" size={24} />
      </span>
    </button>
  </div>

  <nav id="mobile-nav" class="mobile-menu" aria-label="Mobile Navigation" hidden>
    <div class="mobile-menu-inner">
      <a href="#features" class="mobile-nav-link">Features</a>
      <a href="#screenshots" class="mobile-nav-link">Screenshots</a>
      <a href="#how-it-works" class="mobile-nav-link">How it works</a>
      <a href="#download" class="mobile-nav-link">Download</a>
      <a href="#requirements" class="mobile-nav-link">Requirements</a>
      <a href="#changelog" class="mobile-nav-link">Changelog</a>
      <a href="#faq" class="mobile-nav-link">FAQ</a>
      <div class="mobile-nav-cta-box">
        <a href={siteConfig.downloadUrl} class="btn btn-primary mobile-nav-cta">
          <Icon name="download" size={18} />
          <span>Download {siteConfig.appName}</span>
        </a>
      </div>
    </div>
  </nav>
</header>
