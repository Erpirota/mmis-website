---
interface Props {
  name: string;
  size?: number;
  class?: string;
}

const { name, size = 24, class: className = '' } = Astro.props;

// Load all icon SVGs as raw strings via Vite
const iconFiles = import.meta.glob<string>('../assets/app-icons/*.svg', {
  query: '?raw',
  import: 'default',
  eager: true,
});

const iconPath = `../assets/app-icons/${name}.svg`;
const rawSvg = iconFiles[iconPath] || '';

// Clean SVG if needed and inject size/class attributes
// We replace the opening <svg ...> tag to enforce width, height, and custom class
const cleanedSvg = rawSvg
  ? rawSvg.replace(
      /<svg([^>]*)>/,
      `<svg$1 width="${size}" height="${size}" class="app-icon ${className}">`
    )
  : '';
---

<Fragment set:html={cleanedSvg} />
